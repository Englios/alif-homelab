---
# aitrade-auth.sops.yaml.example
#
# The live encrypted file lives at
#   clusters/homelab/aitrade/aitrade-auth.sops.yaml
# (referenced from kustomization.yaml resources list).
# To create it for the first time, copy this template there, fill in real
# deploy-key values, then encrypt with SOPS:
#
#   sops --encrypt --in-place clusters/homelab/aitrade/aitrade-auth.sops.yaml
#
# THIS FILE IS NOT ENCRYPTED. It is a plain-text template for reference only.
# The actual secret file (*.sops.yaml) is encrypted and excluded from
# accidental commit only when properly encrypted (the .gitignore allows
# *.sops.yaml through).
#
# Authentication uses an SSH deploy key (write-enabled) for a single repo.
# The GitRepository URL is ssh://git@github.com/Englios/ai-trade.git.
# ImageUpdateAutomation pushes tag-bump commits back to the same repo
# using the same deploy key, so the key must have write access.
#
# Deploy key title in GitHub: "flux-aitrade-image-automation"
# Repository: https://github.com/Englios/ai-trade
# Settings: Settings → Deploy keys → Add deploy key
# Permissions: Read/write (Allow write access checked)
#
# IMPORTANT: These are FAKE placeholder values. Do not use them.
apiVersion: v1
kind: Secret
metadata:
  name: aitrade-auth
  namespace: flux-system
type: Opaque
data:
  # SSH private key — base64-encoded PEM.
  # Generate outside the repo with restricted permissions:
  #   (umask 077; ssh-keygen -t ed25519 -C "flux-aitrade@englios" -f ~/.ssh/flux-aitrade)
  # Encode:  base64 -w0 ~/.ssh/flux-aitrade
  # Add the public key to GitHub: Settings → Deploy keys → Add deploy key
  #
  # FAKE placeholder — DO NOT USE:
  identity: "c3NoLXJzYSBGRUtFIFBMQUNFSE9MREVSX1BSaVZBVEVfS0VZCg=="

  # SSH public key — base64-encoded. Flux presents this to GitHub for client
  # authentication during the SSH handshake (not for host verification).
  # Encode: base64 -w0 ~/.ssh/flux-aitrade.pub
  #
  # FAKE placeholder — DO NOT USE:
  identity.pub: "c3NoLWVkMjU1MTkgQUFBQUMzTnphQzFsWkRJMU5URTVBQUFBSUhYbFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYUFGRUtFCg=="

  # SSH known_hosts — base64-encoded. Tells Flux which server (GitHub) to
  # trust when cloning over SSH (host verification). Generate once with:
  #   ssh-keyscan github.com 2>/dev/null | base64 -w0
  # IMPORTANT: Before trusting the output, verify the returned host key
  # fingerprint against GitHub's published SSH host keys:
  #   https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints
  # Verify by piping the raw key through ssh-keygen:
  #   ssh-keyscan -t ed25519 github.com 2>/dev/null | ssh-keygen -lf -
  # Compare the SHA256 fingerprint printed to the one listed at the URL
  # above. If they match, the known_hosts base64 from the first command
  # is safe to use.
  # Then paste the base64 output below.
  #
  # FAKE placeholder — DO NOT USE:
  known_hosts: "Z2l0aHViLmNvbSBzc2gtZWQyNTUxOSBBQUFBQzNOemFDMWxkRjFzWldOdklFMzVrS2pRNmNHRXpOaGh1dVc0OUFBQUFJSEh2U1lBQUFBQUFBQUFBQUFBQXNBY0FBQUFBQUFBQUFBQ0FBd0FBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQQo="

  # Rotation (replacing a compromised or expiring deploy key):
  # 1. Generate a new key pair outside the repo:
  #      (umask 077; ssh-keygen -t ed25519 -C "flux-aitrade-$(date +%F)" -f ~/.ssh/flux-aitrade)
  # 2. Add the new public key to GitHub Deploy keys (old key stays valid).
  # 3. Edit the live encrypted file with SOPS:
  #      sops clusters/homelab/aitrade/aitrade-auth.sops.yaml
  #    Replace identity and identity.pub with the new base64-encoded values.
  # 4. Commit and push the updated encrypted file.
  # 5. Tell Flux to re-read the Secret:
  #      flux reconcile source git aitrade
  # 6. Verify Flux can still clone:
  #      kubectl -n flux-system get gitrepository aitrade \
  #        -o jsonpath='{.status.conditions[?(@.type=="Ready")].message}'
  #    Expect "Fetched revision: ...".
  # 7. Only after verification: remove the old deploy key from GitHub.
