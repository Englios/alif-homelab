# Example only. Copy to object-storage-secrets.sops.yaml, fill in, then:
#   sops --encrypt --in-place clusters/homelab/secrets/object-storage-secrets.sops.yaml
apiVersion: v1
kind: Secret
metadata:
  name: rustfs-root
  namespace: object-storage
type: Opaque
stringData:
  RUSTFS_ACCESS_KEY: "<root access key>"
  RUSTFS_SECRET_KEY: "<root secret key, 40+ chars>"
